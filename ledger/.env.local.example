# Copy this file to .env.local and fill in your Firebase project's web config.
# Firebase Console -> Project settings -> General -> Your apps -> SDK setup and configuration

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- AI Assistant (natural-language query, natural-language data entry) —
#     app/api/ai/*, contexts/AiAssistantContext.tsx ---
# All three variables below are SERVER-SIDE ONLY. Set them in your
# deployment's environment variables (never with a NEXT_PUBLIC_ prefix, and
# never commit real values) — they must never reach the browser bundle.

# DeepSeek API key. platform.deepseek.com -> API Keys.
# The assistant calls DeepSeek V4 Flash (deepseek-v4-flash) through
# DeepSeek's Anthropic-compatible endpoint — chosen because every call this
# feature makes is a bounded, mechanical task (classify a request, phrase
# an already-computed number) rather than open-ended reasoning, so a
# budget-tier model's accuracy is more than sufficient, at roughly a fifth
# of Claude Haiku 4.5's per-token cost.
DEEPSEEK_API_KEY=

# Firebase Admin service account, used by app/api/ai/* to verify the
# caller's ID token and read/write Firestore server-side (see
# lib/firebaseAdmin.ts). Firebase Console -> Project settings -> Service
# accounts -> Generate new private key, which downloads a JSON file
# containing these three fields.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key field from the downloaded JSON exactly as-is,
# including the literal \n sequences and the BEGIN/END PRIVATE KEY lines —
# lib/firebaseAdmin.ts un-escapes them back into a real PEM at startup.
FIREBASE_PRIVATE_KEY=
