rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Every document lives under users/{uid}/... — a user can only ever
    // read or write their own subtree. No cross-user sharing, matching the
    // "solo use" requirement; nothing else needs to be open.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
