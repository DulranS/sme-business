rules_version = '2';

// ---------------------------------------------------------------------------
// This is the actual security boundary for the app — everything the client
// (lib/permissions.ts, contexts/DataContext.tsx) does to hide buttons or
// skip a subscription is UX, not enforcement. If a rule and the client
// disagree, the rule wins and the person just sees a failed write.
//
// Data model
//   users/{businessId}/...            — every business's data, unchanged
//                                        from the single-user version. The
//                                        business's uid IS the owner's uid.
//   users/{businessId}/members/{uid}  — one doc per person with access.
//                                        The single source of truth for
//                                        "what can this uid do here" — role,
//                                        active/removed. Every rule below
//                                        reads this, never anything else,
//                                        for a permission decision.
//   users/{businessId}/invites/{id}   — pending invitations, created by the
//                                        owner, accepted by the invitee.
//   memberships/{uid}                 — a top-level pointer, one per
//                                        person, written once and never
//                                        updated: { businessId }. Exists
//                                        purely so a freshly signed-in
//                                        client can find its own business
//                                        with a single doc read by uid.
//                                        Carries no role — role always
//                                        comes from the members doc above,
//                                        so there is exactly one place a
//                                        role can be wrong, and it isn't
//                                        this one.
//
// Role matrix (mirrors lib/permissions.ts — keep both in sync)
//   owner   — full read/write on everything in their business. Only the
//             owner can manage the team, change settings, view the audit
//             log, delete a record, or correct a saved cash count /
//             receivable payment / payable payment after the fact.
//   manager — create/update on the operational collections (products,
//             purchases, purchase orders, sales, expenses, variable costs,
//             capital entries, loans, cash counts, receivable payments).
//             No delete anywhere. No access to employees/payroll, team
//             management, settings, or the audit log.
//   staff   — create-only on sales, cash counts, receivable payments, and
//             time entries (can also clock themselves out of a running time
//             entry, and nothing else about it), and only ever able to read
//             the ones they created themselves.
//             Read-only on `catalog` (a cost-stripped product mirror) and
//             `meta/settings`. No access to anything else, including the
//             real `products`/`purchases` collections that carry cost
//             data — that's the mechanism that keeps a till-level employee
//             from ever being able to see, let alone alter, a margin.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(businessId) {
      return signedIn() && request.auth.uid == businessId;
    }

    function memberDoc(businessId) {
      return get(/databases/$(database)/documents/users/$(businessId)/members/$(request.auth.uid));
    }

    function isActiveMember(businessId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(businessId)/members/$(request.auth.uid))
        && memberDoc(businessId).data.active == true;
    }

    function myRole(businessId) {
      return memberDoc(businessId).data.role;
    }

    function isManager(businessId) {
      return isActiveMember(businessId) && myRole(businessId) == 'manager';
    }

    function isStaff(businessId) {
      return isActiveMember(businessId) && myRole(businessId) == 'staff';
    }

    // Owner + Manager are treated identically almost everywhere — see the
    // module comment above for why the hard line in this app is Staff vs.
    // everyone else, not a three-way split.
    function isOwnerOrManager(businessId) {
      return isOwner(businessId) || isManager(businessId);
    }

    function isOwnerOrActiveMember(businessId) {
      return isOwner(businessId) || isActiveMember(businessId);
    }

    // A record's own createdByUid must match whoever is writing it — used
    // on every create in the operational collections so nobody can log an
    // entry and attribute it to somebody else.
    function createdBySelf() {
      return request.resource.data.createdByUid == request.auth.uid;
    }

    // ------------------------------------------------------------------
    // memberships/{uid} — the bootstrapping pointer. See module comment.
    // ------------------------------------------------------------------
    match /memberships/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      allow create: if signedIn() && request.auth.uid == uid && (
        // A brand-new business: the account creating it owns it.
        request.resource.data.businessId == uid
        ||
        // Accepting a pending invite — validated against the exact invite
        // being claimed, matched by id, status, and email.
        (
          request.resource.data.inviteId is string &&
          get(/databases/$(database)/documents/users/$(request.resource.data.businessId)/invites/$(request.resource.data.inviteId)).data.status == 'pending' &&
          get(/databases/$(database)/documents/users/$(request.resource.data.businessId)/invites/$(request.resource.data.inviteId)).data.email == request.auth.token.email.lower()
        )
      );

      // Never updated — role/business assignment for a given uid is
      // immutable once set. Leaving a business or being removed is handled
      // by deactivating the members doc, not by touching this pointer.
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ------------------------------------------------------------------
    // A business's data, rooted at the owner's uid.
    // ------------------------------------------------------------------
    match /users/{businessId} {
      // The owner's own top-level doc (created at signup) isn't otherwise
      // used by the app, but harmless to let the owner read/write it.
      allow read, write: if isOwner(businessId);

      match /meta/settings {
        allow read: if isOwnerOrActiveMember(businessId);
        allow write: if isOwner(businessId);
      }

      match /products/{docId} {
        allow read: if isOwnerOrManager(businessId);
        allow create, update: if isOwnerOrManager(businessId);
        allow delete: if isOwner(businessId);
      }

      // Cost-stripped product mirror — this is what Staff reads instead of
      // `products`. Only Owner/Manager ever write it (DataContext keeps it
      // in sync alongside every product create/update/delete).
      match /catalog/{docId} {
        allow read: if isOwnerOrActiveMember(businessId);
        allow write: if isOwnerOrManager(businessId);
      }

      match /purchases/{docId} {
        allow read: if isOwnerOrManager(businessId);
        allow create, update: if isOwnerOrManager(businessId);
        allow delete: if isOwner(businessId);
      }

      match /purchaseOrders/{docId} {
        allow read: if isOwnerOrManager(businessId);
        allow create, update: if isOwnerOrManager(businessId);
        allow delete: if isOwner(businessId);
      }

      // Sales are the one collection every role can create into. Editing
      // or deleting one — even your own — is Owner/Manager only: that's
      // the specific rule that makes "log it low, correct it later"
      // impossible for Staff, on purpose.
      match /sales/{docId} {
        allow read: if isOwnerOrManager(businessId)
          || (isStaff(businessId) && resource.data.createdByUid == request.auth.uid);
        allow create: if isOwnerOrActiveMember(businessId) && createdBySelf();
        allow update, delete: if isOwnerOrManager(businessId);
      }

      match /expenses/{docId} {
        allow read: if isOwnerOrManager(businessId);
        allow create, update: if isOwnerOrManager(businessId);
        allow delete: if isOwner(businessId);
      }

      match /variableCosts/{docId} {
        allow read: if isOwnerOrManager(businessId);
        allow create, update: if isOwnerOrManager(businessId);
        allow delete: if isOwner(businessId);
      }

      match /capitalEntries/{docId} {
        allow read: if isOwnerOrManager(businessId);
        allow create, update: if isOwnerOrManager(businessId);
        allow delete: if isOwner(businessId);
      }

      match /loans/{docId} {
        allow read: if isOwnerOrManager(businessId);
        allow create, update: if isOwnerOrManager(businessId);
        allow delete: if isOwner(businessId);
      }

      // Payroll. Owner only, full stop — not even Manager.
      match /employees/{docId} {
        allow read, write: if isOwner(businessId);
      }

      // End-of-shift cash reconciliation. Every active role can log one for
      // themselves; whoever counted it can never edit it afterward — see
      // the CashCount doc comment in lib/types.ts for why that's the
      // anti-theft point. The one exception is the Owner, who can correct a
      // genuine data-entry mistake (a typo'd amount, wrong date) without
      // having to delete and lose the record — same trust boundary as
      // deleting one, just also allowing update now instead of forcing a
      // destroy-and-recreate for something as small as a typo.
      match /cashCounts/{docId} {
        allow read: if isOwnerOrManager(businessId)
          || (isStaff(businessId) && resource.data.createdByUid == request.auth.uid);
        allow create: if isOwnerOrActiveMember(businessId) && createdBySelf();
        allow update: if isOwner(businessId);
        allow delete: if isOwner(businessId);
      }

      // Clock in/out records. Every active role can create one for
      // themselves; Owner/Manager can also create one on someone else's
      // behalf (backfilling a missed clock-in) or correct any entry. The
      // one thing a Staff member can still do after saving their own entry
      // is clock out of it — but that update may touch `clockOut` and
      // nothing else, and only once, so the running duration on record can
      // never be quietly stretched or shrunk after the fact.
      match /timeEntries/{docId} {
        allow read: if isOwnerOrManager(businessId)
          || (isStaff(businessId) && resource.data.memberUid == request.auth.uid);
        allow create: if isOwnerOrManager(businessId)
          || (isOwnerOrActiveMember(businessId) && createdBySelf() && request.resource.data.memberUid == request.auth.uid);
        allow update: if isOwnerOrManager(businessId) || (
          isOwnerOrActiveMember(businessId)
          && resource.data.memberUid == request.auth.uid
          && !resource.data.keys().hasAny(['clockOut'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clockOut'])
        );
        allow delete: if isOwnerOrManager(businessId);
      }

      // Payments collected against a credit sale. Same shape as sales:
      // anyone active can create one (for a sale they can see); only Owner
      // can edit or delete one afterward, to correct a mis-keyed amount,
      // date, or method.
      match /receivablePayments/{docId} {
        allow read: if isOwnerOrManager(businessId)
          || (isStaff(businessId) && resource.data.createdByUid == request.auth.uid);
        allow create: if isOwnerOrActiveMember(businessId) && createdBySelf();
        allow update: if isOwner(businessId);
        allow delete: if isOwner(businessId);
      }

      // Team membership records — the authoritative role/active source
      // every function above reads. Owner manages the roster; the one
      // exception is a person creating their own doc at invite-acceptance
      // time, validated against the specific pending invite they're
      // claiming.
      match /members/{uid} {
        allow read: if isOwner(businessId) || (signedIn() && request.auth.uid == uid);
        allow create: if isOwner(businessId) || (
          signedIn() && request.auth.uid == uid &&
          request.resource.data.inviteId is string &&
          get(/databases/$(database)/documents/users/$(businessId)/invites/$(request.resource.data.inviteId)).data.status == 'pending' &&
          get(/databases/$(database)/documents/users/$(businessId)/invites/$(request.resource.data.inviteId)).data.email == request.auth.token.email.lower() &&
          get(/databases/$(database)/documents/users/$(businessId)/invites/$(request.resource.data.inviteId)).data.role == request.resource.data.role &&
          request.resource.data.active == true
        );
        allow update: if isOwner(businessId);
        allow delete: if false; // access is revoked via active:false, never by deleting the record
      }

      match /invites/{inviteId} {
        // The owner sees the whole list; anyone else can only ever read
        // the one invite that names their own email — enough to complete
        // the join flow, nothing more.
        allow read: if isOwner(businessId)
          || (signedIn() && resource.data.email == request.auth.token.email.lower());
        allow create: if isOwner(businessId);
        // Owner can revoke; the invitee can only flip their own pending
        // invite to accepted, nothing else about it.
        allow update: if isOwner(businessId) || (
          signedIn() &&
          resource.data.email == request.auth.token.email.lower() &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'accepted'
        );
        allow delete: if isOwner(businessId);
      }

      // Append-only activity trail. Every active member can write an entry
      // describing their own action; nobody, including the owner, can
      // change or remove one afterward. Only the owner can read it.
      match /auditLog/{docId} {
        allow read: if isOwner(businessId);
        allow create: if isOwnerOrActiveMember(businessId) && request.resource.data.byUid == request.auth.uid;
        allow update, delete: if false;
      }

      // Reminders/alerts surfaced in the notifications page. Owner/Manager
      // only, same as everywhere else `manage:notifications` gates the
      // client (see lib/permissions.ts) — Staff has no notifications UI.
      match /notifications/{docId} {
        allow read, write: if isOwnerOrManager(businessId);
      }

      // Payments recorded against an outstanding purchase (supplier owed
      // money). Same shape as receivablePayments: anyone active can create
      // one; only Owner can edit or delete one afterward.
      match /payablePayments/{docId} {
        allow read: if isOwnerOrManager(businessId)
          || (isStaff(businessId) && resource.data.createdByUid == request.auth.uid);
        allow create: if isOwnerOrActiveMember(businessId) && createdBySelf();
        allow update: if isOwner(businessId);
        allow delete: if isOwner(businessId);
      }

      // Fixed assets (machinery, vehicles, equipment) for depreciation
      // tracking. Owner/Manager only, matching `manage:fixedAssets` in
      // lib/permissions.ts.
      match /fixedAssets/{docId} {
        allow read, write: if isOwnerOrManager(businessId);
      }

      // Job/project costing. Owner/Manager only, matching `manage:projects`
      // in lib/permissions.ts — Staff never sees cost or margin data
      // anywhere else in this app, and a project's whole point is
      // margin-against-quote, so it stays behind the same line.
      match /projects/{docId} {
        allow read, write: if isOwnerOrManager(businessId);
      }
      match /projectCostSegments/{docId} {
        allow read, write: if isOwnerOrManager(businessId);
      }
      // Progress-billing schedule lines for a project (deposit, milestone
      // payments, final payment). Same trust boundary as the rest of
      // project costing — Owner/Manager only.
      match /projectMilestones/{docId} {
        allow read, write: if isOwnerOrManager(businessId);
      }
    }
  }
}
