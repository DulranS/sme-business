rules_version = '2';

// Mirrors the ownership model in firestore.rules: businessId IS the
// owner's uid, so only the signed-in owner can upload/replace/delete the
// logo stored at logos/{businessId}/logo.png. Read is left open — a
// getDownloadURL() link already carries its own access token regardless
// of these rules (that's how the print/invoice views load the image
// without the viewer being signed in), so restricting read here wouldn't
// add real protection, only friction. Nothing else lives in this bucket.
service firebase.storage {
  match /b/{bucket}/o {
    match /logos/{businessId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == businessId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == businessId;
    }
  }
}
